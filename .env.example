# Optional settings for running from source. The desktop app works without a .env file.
# Packaged app: put a .env in its data folder (see README) to override these.

# Try MailMaster with sample emails (no accounts needed)
DEMO_MODE=0

# Microsoft app (client) ID for Outlook / Hotmail / Microsoft 365 accounts.
# Official builds have it built in. No client secret is needed.
CLIENT_ID=

PORT=3500
MAX_MESSAGES=300
MAX_JUNK=100
MAX_DELETED=100
